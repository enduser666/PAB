<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_background_059">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen_059">

        <!-- Judul Seksi "Pengaturan Akun" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seksi_pengaturan_akun"
            android:textColor="@color/color_text_primary_059"
            android:textSize="@dimen/text_title_large_059"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_16_059" />

        <!-- Panel Besar berlatar primary_soft rounded 20dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_settings_059"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20_059"
            android:layout_marginBottom="@dimen/spacing_32_059">

            <!-- Baris Atas: Label & Tombol Pensil Edit Profil -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16_059">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/label_profil_username"
                    android:textColor="@color/color_text_primary_059"
                    android:textSize="@dimen/text_body_059"
                    android:fontFamily="sans-serif-medium" />

                <!-- Tombol Pensil Bulat -->
                <FrameLayout
                    android:id="@+id/btnEditProfil059"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_button_059"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit_pencil_059"
                        android:contentDescription="@string/judul_ubah_profil" />
                </FrameLayout>
            </RelativeLayout>

            <!-- Nilai Username -->
            <TextView
                android:id="@+id/tvProfilUsername059"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_primary_dark_059"
                android:textSize="@dimen/text_title_059"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/spacing_16_059"
                tools:text="azriel059" />

            <!-- Garis Pemisah Tipis -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_divider_059"
                android:background="@color/color_divider_purple_059"
                android:layout_marginBottom="@dimen/spacing_16_059" />

            <!-- Kata Sandi (Label + Nilai Titik-titik) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_profil_password"
                android:textColor="@color/color_text_primary_059"
                android:textSize="@dimen/text_body_059"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/spacing_4_059" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dummy_password_dots"
                android:textColor="@color/color_primary_dark_059"
                android:textSize="@dimen/text_title_059"
                android:letterSpacing="0.2"
                android:layout_marginBottom="@dimen/spacing_16_059" />

            <!-- Garis Pemisah Tipis -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_divider_059"
                android:background="@color/color_divider_purple_059"
                android:layout_marginBottom="@dimen/spacing_16_059" />

            <!-- Jumlah Barang -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_profil_jumlah_barang"
                android:textColor="@color/color_text_primary_059"
                android:textSize="@dimen/text_body_059"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/spacing_4_059" />

            <TextView
                android:id="@+id/tvProfilJumlahBarang059"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_primary_dark_059"
                android:textSize="@dimen/text_title_059"
                android:fontFamily="sans-serif-medium"
                tools:text="12 jenis barang" />

        </LinearLayout>

        <!-- Tombol "Keluar" Outline Merah/Ungu Full-width -->
        <Button
            android:id="@+id/btnLogout059"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_059"
            android:text="@string/btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/color_error_059"
            android:strokeColor="@color/color_error_059"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/text_title_059" />

    </LinearLayout>
</ScrollView>
