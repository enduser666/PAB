<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowKategoriSummary059"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_12_059"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvNamaKategoriSummary059"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/color_text_primary_059"
        android:textSize="@dimen/text_title_059"
        android:fontFamily="sans-serif-medium"
        tools:text="Elektronik" />

    <TextView
        android:id="@+id/tvJumlahBarangKategori059"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_primary_059"
        android:textSize="@dimen/text_body_059"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/spacing_8_059"
        tools:text="8 barang" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right_059"
        android:contentDescription="@null" />

</LinearLayout>
