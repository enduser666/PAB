<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_background_059">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen_059">

        <!-- Sapaan kecil di atas judul seksi -->
        <TextView
            android:id="@+id/tvSapaan059"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_secondary_059"
            android:textSize="@dimen/text_body_059"
            tools:text="Halo, Azriel" />

        <!-- Judul seksi "Ringkasan" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seksi_ringkasan"
            android:textColor="@color/color_text_primary_059"
            android:textSize="@dimen/text_title_large_059"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_16_059" />

        <!-- Grid Statistik: Baris 1: JENIS BARANG & TOTAL STOK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_12_059">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Inventaris059.Card.Stat"
                android:layout_marginEnd="@dimen/spacing_8_059">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16_059">

                    <TextView
                        android:id="@+id/tvJenisBarang059"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_display_059"
                        android:textColor="@color/color_primary_059"
                        android:fontFamily="sans-serif-medium"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_jenis_barang"
                        android:textColor="@color/color_text_secondary_059"
                        android:textSize="@dimen/text_label_059"
                        android:letterSpacing="0.06" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Inventaris059.Card.Stat"
                android:layout_marginStart="@dimen/spacing_8_059">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16_059">

                    <TextView
                        android:id="@+id/tvTotalStok059"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_display_059"
                        android:textColor="@color/color_primary_059"
                        android:fontFamily="sans-serif-medium"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_total_stok"
                        android:textColor="@color/color_text_secondary_059"
                        android:textSize="@dimen/text_label_059"
                        android:letterSpacing="0.06" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Grid Statistik: Baris 2: KATEGORI & STOK MENIPIS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_12_059">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Inventaris059.Card.Stat"
                android:layout_marginEnd="@dimen/spacing_8_059">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16_059">

                    <TextView
                        android:id="@+id/tvKategoriStat059"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_display_059"
                        android:textColor="@color/color_primary_059"
                        android:fontFamily="sans-serif-medium"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_kategori_stat"
                        android:textColor="@color/color_text_secondary_059"
                        android:textSize="@dimen/text_label_059"
                        android:letterSpacing="0.06" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Inventaris059.Card.Stat"
                android:layout_marginStart="@dimen/spacing_8_059">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16_059">

                    <TextView
                        android:id="@+id/tvStokMenipis059"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_display_059"
                        android:textColor="@color/color_primary_059"
                        android:fontFamily="sans-serif-medium"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_stok_menipis"
                        android:textColor="@color/color_text_secondary_059"
                        android:textSize="@dimen/text_label_059"
                        android:letterSpacing="0.06" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Grid Statistik: Baris 3: STOK HABIS (Full Width) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Inventaris059.Card.Stat"
            android:layout_marginBottom="@dimen/spacing_20_059">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16_059">

                <TextView
                    android:id="@+id/tvStokHabis059"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_display_059"
                    android:textColor="@color/color_primary_059"
                    android:fontFamily="sans-serif-medium"
                    tools:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_stok_habis"
                    android:textColor="@color/color_text_secondary_059"
                    android:textSize="@dimen/text_label_059"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Garis tipis ungu pemisah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_divider_059"
            android:background="@color/color_divider_purple_059"
            android:layout_marginBottom="@dimen/spacing_20_059" />

        <!-- Panel lebar berlatar primary_soft (Total Nilai Inventaris) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_total_059"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20_059"
            android:layout_marginBottom="@dimen/spacing_24_059">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total_nilai"
                android:textColor="@color/color_primary_059"
                android:textSize="@dimen/text_label_059"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/spacing_4_059" />

            <TextView
                android:id="@+id/tvTotalNilai059"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_display_059"
                android:textColor="@color/color_primary_dark_059"
                android:fontFamily="sans-serif-medium"
                tools:text="Rp 0" />
        </LinearLayout>

        <!-- Judul seksi "Stok Terendah" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seksi_stok_terendah"
            android:textColor="@color/color_text_primary_059"
            android:textSize="@dimen/text_title_large_059"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_12_059" />

        <!-- Panel abu rounded berisi maksimal 3 baris item stok terendah -->
        <LinearLayout
            android:id="@+id/layoutStokTerendahContainer059"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_gray_059"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16_059"
            android:layout_marginBottom="@dimen/spacing_24_059">

            <!-- Container dinamis baris item -->
            <LinearLayout
                android:id="@+id/layoutStokTerendahList059"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty state jika belum ada barang -->
            <LinearLayout
                android:id="@+id/layoutStokTerendahEmpty059"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="@dimen/spacing_16_059"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_stok_terendah"
                    android:textColor="@color/color_text_secondary_059"
                    android:textSize="@dimen/text_body_059"
                    android:layout_marginBottom="@dimen/spacing_12_059" />

                <Button
                    android:id="@+id/btnEmptyKeTambah059"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_tambah_barang"
                    style="@style/Widget.Inventaris059.Button.Primary" />
            </LinearLayout>

        </LinearLayout>

        <!-- Judul seksi "Ringkasan Kategori" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seksi_ringkasan_kategori"
            android:textColor="@color/color_text_primary_059"
            android:textSize="@dimen/text_title_large_059"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_12_059" />

        <!-- Panel abu rounded berisi maksimal 4 kategori terbanyak -->
        <LinearLayout
            android:id="@+id/layoutKategoriSummaryContainer059"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_gray_059"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16_059">

            <LinearLayout
                android:id="@+id/layoutKategoriSummaryList059"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty state kategori jika belum ada kategori -->
            <TextView
                android:id="@+id/tvEmptyKategoriSummary059"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_kategori"
                android:textColor="@color/color_text_secondary_059"
                android:textSize="@dimen/text_body_059"
                android:gravity="center"
                android:paddingVertical="@dimen/spacing_16_059"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Bottom spacer -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_24_059" />

    </LinearLayout>
</ScrollView>
